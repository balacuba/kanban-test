# Cấu hình Kanban relay. Chép file này thành relay.env rồi sửa.
# Chuyển sang server planning khác: chỉ cần đổi PLANNING_URL (và APP_ORIGIN nếu server kiểm tra Origin), chạy lại relay.

# Địa chỉ server planning (bắt buộc)
PLANNING_URL=http://14.241.68.10:3000

# Cổng relay mở cho Kanban / TV
PORT=8765

# Origin gửi kèm khi gọi server planning (server chỉ nhận yêu cầu từ địa chỉ của ứng dụng). Trống = PLANNING_URL
APP_ORIGIN=

# Trang được phép nghe SSE (CORS). * = mọi trang; nên đặt địa chỉ ứng dụng Jmix, vd. http://14.241.68.10:3000
ALLOW_ORIGIN=*

# Chu kỳ kiểm tra số liệu mới (ms)
POLL_MS=3000

# File tài khoản (mặc định .env.token cạnh server.mjs)
# TOKEN_FILE=
